{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Blender: avvia sessione MCP isolata",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\start-blender.ps1"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Blender: test API dirette",
      "type": "process",
      "command": "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe",
      "args": ["--background", "--factory-startup", "--disable-autoexec", "--python-exit-code", "1", "--python", "${workspaceFolder}\\scripts\\direct.py"],
      "problemMatcher": []
    },
    {
      "label": "Blender: test MCP completo",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\test_mcp.py"],
      "problemMatcher": []
    },
    {
      "label": "Blender: verifica file salvati",
      "type": "process",
      "command": "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe",
      "args": ["--background", "--factory-startup", "--disable-autoexec", "--python-exit-code", "1", "--python", "${workspaceFolder}\\scripts\\validate_outputs.py"],
      "problemMatcher": []
    }
  ]
}
